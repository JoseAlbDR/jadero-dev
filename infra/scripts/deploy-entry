#!/bin/bash
#
# deploy-entry: the forced command of the deploy user's only SSH key (WP-8 D3, ADR-049 restating
# ADR-048's deploy mechanics). Installed root-owned, mode 755, as /srv/jadero/bin/deploy-entry.
#
# sshd runs this file whatever the client asks for. Each key line binds it to one environment
# (WP-9 D2): `command="/srv/jadero/bin/deploy-entry staging"` for the staging key,
# `... deploy-entry prod` for production's, so a leaked staging key never reaches production. The
# client's words arrive only as the SSH_ORIGINAL_COMMAND variable, and this script accepts exactly
# two shapes, whose environment word must equal the key line's:
#
#   deploy <env> <service> <version>
#   rollback <env> <service>
#
# `redeploy` is not one of them: it runs from the owner's root shell only (D3). Each word is
# checked against an allowlist, then the values are passed as separate arguments to the one
# script the sudoers rule allows, with standard input (the registry user and token, for prod the
# expected digest) passed through untouched. The client's input is never evaluated, never handed
# to a shell and never written to the log.
#
# Environment: sshd's PermitUserEnvironment is off by default, but the client can still send the
# variables AcceptEnv lists, and Ubuntu's sshd_config accepts LANG and every LC_* (`restrict` on
# the key does not change that). The locale decides what a bracket range such as [A-Za-z] means:
# under a UTF-8 locale glibc matches letters like a-umlaut or fullwidth A in it, so the
# allowlists below would let non-ASCII through. LC_ALL=C, set before the first match, pins every
# check to ASCII bytes whatever the client sends. Nothing here reads a path from the environment:
# the paths below are fixed constants, and the tests run a copy with those lines rewritten.

set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C

readonly DEPLOY_SH=/srv/jadero/bin/deploy.sh
readonly SUDO=/usr/bin/sudo
readonly LOGGER=/usr/bin/logger

# The services release-please publishes today. `contact` joins when it ships.
readonly SERVICES="api agent web"
readonly USAGE='refused: expected "deploy <env> <service> <version>" or "rollback <env> <service>"'
readonly MAX_LENGTH=128

# Characters allowed anywhere in the command, checked before splitting: letters, digits, space,
# dot and hyphen. Everything a shell could act on (; $ ` ' " | & newline) fails here.
readonly ALLOWED_CHARS='^[A-Za-z0-9 .-]+$'
# Semantic version MAJOR.MINOR.PATCH, no leading zeros, an optional pre-release of dot-separated
# identifiers. No leading `v`, no build metadata.
readonly VERSION_RE='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

# Writes one line to the system log under the tag jadero-deploy. Best effort: a missing logger
# does not block a deploy, and sudo logs the accepted command on its own.
# Arguments: the message, built only from fixed text and values that passed the allowlists.
log_line() {
  "$LOGGER" -t jadero-deploy -- "$1" 2>/dev/null || true
}

# Logs a fixed reason (never the raw input, so the client cannot inject log lines), prints the
# usage to stderr and exits 1.
# Arguments: the reason, one of the fixed words used below.
refuse() {
  log_line "refused reason=$1"
  echo "$USAGE" >&2
  exit 1
}

# The environment this key may act on, from the key line itself (not from the client).
[[ $# -eq 1 ]] || refuse no-binding
case "$1" in
  staging | prod) bound_env="$1" ;;
  *) refuse no-binding ;;
esac

command_line="${SSH_ORIGINAL_COMMAND-}"

[[ -n "$command_line" ]] || refuse empty
[[ ${#command_line} -le $MAX_LENGTH ]] || refuse too-long
[[ "$command_line" =~ $ALLOWED_CHARS ]] || refuse bad-characters

IFS=' ' read -r -a words <<<"$command_line"
[[ ${#words[@]} -eq 3 || ${#words[@]} -eq 4 ]] || refuse word-count
verb="${words[0]}"
case "$verb" in
  deploy) [[ ${#words[@]} -eq 4 ]] || refuse word-count ;;
  rollback) [[ ${#words[@]} -eq 3 ]] || refuse word-count ;;
  *) refuse bad-verb ;;
esac

env_name="${words[1]}"
service="${words[2]}"

case "$env_name" in
  staging | prod) ;;
  *) refuse bad-env ;;
esac
[[ "$env_name" == "$bound_env" ]] || refuse env-mismatch

case " $SERVICES " in
  *" $service "*) ;;
  *) refuse bad-service ;;
esac

if [[ "$verb" == deploy ]]; then
  version="${words[3]}"
  [[ "$version" =~ $VERSION_RE ]] || refuse bad-version
  log_line "accepted verb=deploy env=$env_name service=$service version=$version"
  exec "$SUDO" -n "$DEPLOY_SH" deploy "$env_name" "$service" "$version"
fi

log_line "accepted verb=rollback env=$env_name service=$service"
exec "$SUDO" -n "$DEPLOY_SH" rollback "$env_name" "$service"
