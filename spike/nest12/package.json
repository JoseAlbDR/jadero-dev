{
  "name": "wp3-nest12-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'row3/**'",
    "row1": "pnpm build && node dist/row1/main.js",
    "row2": "pnpm build && node dist/row2/main.js",
    "row3": "vitest run row3",
    "row4": "pnpm build && node dist/row4/main.js",
    "row5": "pnpm build && node dist/row5/main.js",
    "row6": "pnpm build && node --import ./dist/row6/instrumentation.js dist/row6/main.js",
    "row6-pg": "pnpm build && node --env-file=../../.env.example --import ./dist/row6/instrumentation.js dist/row6/main.js",
    "row7": "pnpm build && node dist/row7/plain.js && node dist/row7/nest.js"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "9.1.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.18",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/microservices": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@rekog/mcp-nest": "2.0.7",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@testcontainers/rabbitmq": "12.2.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
