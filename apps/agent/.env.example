# Copy to apps/agent/.env for `pnpm start` (read with --env-file-if-exists). Values match
# infra/compose/compose.dev.yml, init/01-databases.sql and infra/rabbitmq/definitions.json;
# never put real secrets here.
NODE_ENV=development
PORT=3002
# Interface the HTTP server binds (default 127.0.0.1, so a dev server is not reachable from the
# network). The images set 0.0.0.0; set it here only to reach the service from another device.
# HOST=127.0.0.1
LOG_LEVEL=debug
# Name in logs and health output; defaults to agent (and to agent-consumer for the consumer).
# SERVICE_NAME=agent
# Largest JSON request body (ADR-047, default 100kb); a larger one answers 413.
HTTP_JSON_BODY_LIMIT=100kb
# Host port 5432 is the compose.dev.yml default; with POSTGRES_PORT set for docker compose, use
# that port here (and RABBITMQ_PORT in RABBITMQ_URL below).
DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/agent_dev
# Most connections in the pool (default 6); the URL above is never logged.
DATABASE_POOL_MAX=6
# OpenTelemetry (ADR-010): pretty in dev (one line per span; console prints the full span object
# for deep debugging), otlp in staging and production, none to silence it.
OTEL_SERVICE_NAME=agent
OTEL_TRACES_EXPORTER=pretty
# Required only with OTEL_TRACES_EXPORTER=otlp: the collector that receives the spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Consumer process only (pnpm dev:worker sets PORT=3012 and SERVICE_NAME=agent-consumer): the
# broker user `agent`, which may read its own queues and write only to agent.retry.
RABBITMQ_URL=amqp://agent:agent@127.0.0.1:5672/dev
# AI providers stay fake in dev and tests (AGENTS.md section 7). Not read yet: the AI ports
# arrive with their WPs; infra/compose/compose.images.yml already sets the same values.
AI_CHAT_PROVIDER=fake
AI_GUARD_PROVIDER=fake
AI_EMBEDDINGS_PROVIDER=fake
AI_RERANK_PROVIDER=fake
