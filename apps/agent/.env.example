# Copy to apps/agent/.env for `pnpm start` (read with --env-file-if-exists). Values match
# infra/compose/compose.dev.yml, init/01-databases.sql and infra/rabbitmq/definitions.json;
# never put real secrets here.
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug
# Largest JSON request body (ADR-047, default 100kb); a larger one answers 413.
HTTP_JSON_BODY_LIMIT=100kb
DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/agent_dev
# Most connections in the pool (default 6); the URL above is never logged.
DATABASE_POOL_MAX=6
# OpenTelemetry (ADR-010): console in dev, otlp in staging and production, none to silence it.
OTEL_SERVICE_NAME=agent
OTEL_TRACES_EXPORTER=console
# Consumer process only (pnpm dev:worker sets PORT=3012 and SERVICE_NAME=agent-consumer): the
# broker user `agent`, which may read its own queues and write only to agent.retry.
RABBITMQ_URL=amqp://agent:agent@127.0.0.1:5672/dev
