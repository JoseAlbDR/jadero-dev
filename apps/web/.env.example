SITE_URL=http://localhost:3000
# Server only, read at request time: the public content API of apps/api (its PORT in apps/api/.env.example).
CONTENT_API_URL=http://localhost:3001
# Read per request by the proxy: enforce (default) or report-only, the opt-out to diagnose a
# violation without blocking (ADR-047).
CSP_MODE=enforce
# Development only (ignored by a production server): 1 logs each content API request with its URL,
# status, duration and body to the server console.
# CONTENT_API_DEBUG=1
# Server only, read per request: the key api-worker signs revalidation calls to /api/revalidate
# with (WP-14), the same value as REVALIDATE_SECRET in apps/api/.env.example. Unset or shorter than
# 32 characters, the route answers 401 to every call. A dev placeholder: never reuse it elsewhere.
REVALIDATE_SECRET=dev-only-revalidate-secret-change-me-0000
