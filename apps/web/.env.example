SITE_URL=http://localhost:3000
# Server only, read at request time: the public content API of apps/api (its PORT in apps/api/.env.example).
CONTENT_API_URL=http://localhost:3001
# Read per request by the proxy: enforce (default) or report-only, the opt-out to diagnose a
# violation without blocking (ADR-047).
CSP_MODE=enforce
# Development only (ignored by a production server): 1 logs each content API request with its URL,
# status, duration and body to the server console.
# CONTENT_API_DEBUG=1
