{
  "name": "@jadero/web",
  "version": "0.2.0",
  "private": true,
  "description": "Public site (ADR-001, ADR-022, ADR-045).",
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "dev": "next dev -H localhost",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@jadero/contracts": "workspace:*",
    "@jadero/ui": "workspace:*",
    "geist": "catalog:",
    "hast-util-to-jsx-runtime": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-sanitize": "catalog:",
    "remark-directive": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "unified": "catalog:",
    "unist-util-visit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@jadero/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/hast": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
