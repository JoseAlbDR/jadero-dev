# Copy to apps/api/.env for `pnpm start` (read with --env-file-if-exists). Values match
# infra/compose/compose.dev.yml and init/01-databases.sql; never put real secrets here.
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
DATABASE_URL=postgres://content:content@127.0.0.1:5432/content_dev
# OpenTelemetry (ADR-010, read by @jadero/platform-nest/instrumentation): console in dev,
# otlp with OTEL_EXPORTER_OTLP_ENDPOINT in staging and production, none to silence it.
OTEL_SERVICE_NAME=api
OTEL_TRACES_EXPORTER=console
# api-worker only (pnpm dev:worker sets PORT=3011 and SERVICE_NAME=api-worker): the broker user
# `api` from infra/rabbitmq/definitions.json, and the heartbeat ping interval (default 5 minutes).
RABBITMQ_URL=amqp://api:api@127.0.0.1:5672/dev
HEARTBEAT_INTERVAL_MS=300000
