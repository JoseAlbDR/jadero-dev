# Local development connection strings for infra/compose/compose.dev.yml (pnpm dev:up).
# These are fixed dev-only passwords for containers bound to 127.0.0.1. They are not secrets and are
# never used outside a laptop. Real values for staging and production come from 1Password (ADR-007).
# Copy to .env if a tool needs it; .env stays gitignored. Each app reads its own
# apps/<app>/.env (copied from apps/<app>/.env.example), not this file.

# One database and one role per service (ADR-029).
CONTENT_DATABASE_URL=postgres://content:content@127.0.0.1:5432/content_dev
# Read-only role of api's public content reads (apps/api DATABASE_READ_URL).
CONTENT_READER_DATABASE_URL=postgres://content_reader:content_reader@127.0.0.1:5432/content_dev
AGENT_DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/agent_dev
CONTACT_DATABASE_URL=postgres://contact:contact@127.0.0.1:5432/contact_dev

# RabbitMQ, vhost `dev` from infra/rabbitmq/definitions.json: one user per service (ADR-029).
# `dev` is the admin for the management UI at http://localhost:15672.
API_RABBITMQ_URL=amqp://api:api@127.0.0.1:5672/dev
AGENT_RABBITMQ_URL=amqp://agent:agent@127.0.0.1:5672/dev

# AI and mail providers stay fake in dev and tests (AGENTS.md section 7).
AI_CHAT_PROVIDER=fake
AI_GUARD_PROVIDER=fake
AI_EMBEDDINGS_PROVIDER=fake
AI_RERANK_PROVIDER=fake
MAIL_PROVIDER=fake
