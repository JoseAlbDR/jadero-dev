{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["AI_*_PROVIDER", "MAIL_PROVIDER"],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/infra/compose/**"],
      "cache": false
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "//#lint": {
      "inputs": [
        "**/*.{ts,tsx,js,mjs,cjs,json,jsonc,css}",
        "biome.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/test-results/**",
        "!**/playwright-report/**"
      ]
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**/*.mjs",
        "turbo.json",
        "apps/*/turbo.json",
        "apps/*/package.json",
        "apps/*/src/**",
        "apps/*/test/**",
        "packages/*/turbo.json",
        "packages/*/package.json",
        "packages/*/src/**",
        "packages/*/test/**",
        "templates/*/turbo.json",
        "templates/*/package.json",
        "templates/*/src/**",
        "templates/*/test/**"
      ]
    },
    "//#depcruise": {
      "inputs": [
        "apps/**",
        "packages/**",
        "templates/**",
        ".dependency-cruiser.cjs",
        "tsconfig.depcruise.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/test-results/**",
        "!**/playwright-report/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "with": ["dev:build"],
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "dev:build": {
      "cache": false,
      "persistent": true
    }
  }
}
