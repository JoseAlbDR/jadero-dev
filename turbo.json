{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["AI_*_PROVIDER", "MAIL_PROVIDER"],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#lint": {
      "inputs": [
        "**/*.{ts,tsx,js,mjs,cjs,json,jsonc,css}",
        "biome.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/test-results/**",
        "!**/playwright-report/**"
      ]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**/*.mjs"]
    },
    "//#depcruise": {
      "inputs": [
        "apps/**",
        "packages/**",
        "templates/**",
        ".dependency-cruiser.cjs",
        "tsconfig.depcruise.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/test-results/**",
        "!**/playwright-report/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "with": ["dev:build"],
      "cache": false,
      "persistent": true
    },
    "dev:build": {
      "cache": false,
      "persistent": true
    }
  }
}
