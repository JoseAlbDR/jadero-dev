{
  "name": "@jadero/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens and shadcn/ui components owned by the repo (ADR-023). Just-in-time package: apps compile its source.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./components/*": "./src/components/*.tsx",
    "./cn": "./src/lib/cn.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@jadero/config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
