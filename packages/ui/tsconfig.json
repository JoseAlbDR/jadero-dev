{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@jadero/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [],
    "paths": { "@jadero/ui/*": ["./src/*"] }
  },
  "include": ["src"]
}
