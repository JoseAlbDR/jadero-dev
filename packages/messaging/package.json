{
  "name": "@jadero/messaging",
  "version": "0.0.0",
  "private": true,
  "description": "Messaging infrastructure shared by the services (ADR-012, ADR-029): the MessageBus port with in-memory and RabbitMQ adapters, the retry and dead-letter policy, the outbox relay and the inbox. Infrastructure only, no domain code. Compiled to dist/.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "topology": "tsc -p tsconfig.build.json && node scripts/write-definitions.mjs"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "catalog:",
    "@jadero/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jadero/config": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@types/amqplib": "catalog:",
    "@types/node": "catalog:",
    "amqplib": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
