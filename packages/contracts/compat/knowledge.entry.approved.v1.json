{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "source": {
      "type": "string",
      "pattern": "^jadero\\/[a-z][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "const": "dev.jadero.knowledge.entry.approved.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^kb-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locale": {
          "type": "string",
          "enum": ["es", "en", "de"]
        },
        "revision": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["id", "number"]
        },
        "approval": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "approved"
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": ["state", "approvedAt"]
        },
        "document": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "type": "string",
              "enum": [
                "feature",
                "improvement",
                "tech-debt",
                "integration",
                "performance",
                "tooling",
                "workshop"
              ]
            },
            "domain": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "period": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["from", "to"]
            },
            "role": {
              "type": "string",
              "enum": ["sole author", "lead", "contributor"]
            },
            "stack": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "indexable": {
              "type": "boolean"
            },
            "cvBullet": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "related": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120,
                "pattern": "^kb-[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "summary",
                      "problem",
                      "whatHeBuilt",
                      "howItWorks",
                      "tradeoffs",
                      "testingRollout",
                      "outcome",
                      "lessons"
                    ]
                  },
                  "body": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": ["key", "body"]
              }
            },
            "questions": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "title",
            "type",
            "domain",
            "period",
            "role",
            "stack",
            "patterns",
            "indexable",
            "cvBullet",
            "related",
            "sections",
            "questions"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      },
      "required": ["entryId", "locale", "revision", "approval", "document", "confidence"]
    }
  },
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"]
}
