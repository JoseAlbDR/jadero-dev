{
  "name": "@jadero/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Message and HTTP contracts shared by the services (ADR-029): the CloudEvents envelope and every event type as Zod schemas, example fixtures, the AsyncAPI catalog. Schemas only, no domain logic. Compiled to dist/.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures",
    "asyncapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "asyncapi": "tsc -p tsconfig.build.json && node scripts/write-asyncapi.mjs"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@asyncapi/parser": "catalog:",
    "@jadero/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
